# Reuse the SAME Supabase project as the original application.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Admin Seedream image generation (server only)
ARK_API_KEY=

# Five-caption Factory (server only)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Original user-facing deployment; gallery/checkboard links redirect here.
USER_SITE_URL=https://thehumorproject-five.vercel.app

# No scheduled tasks on this deployment. The original app owns maintenance.
# Set only if manually enabling its protected maintenance endpoint here.
CRON_SECRET=

# Trusted local audit/migration only; DO NOT deploy this management token.
SUPABASE_ACCESS_TOKEN=
